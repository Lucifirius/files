#!/bin/bash
# yt-dlp best-quality download + background ffmpeg optimize
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: $0 <video_url> [output_dir]"
    exit 1
fi

for bin in yt-dlp ffmpeg; do
    command -v "$bin" >/dev/null 2>&1 || { echo "Error: $bin not found"; exit 1; }
done

URL=$1
OUT_DIR=${2:-.}
mkdir -p "$OUT_DIR"

# yt-dlp prints filepath straight to stdout; capture it directly, no tee/tempfile needed
DOWNLOADED_FILE=$(yt-dlp \
    --format "bestvideo[vcodec^=avc1][ext=mp4]+bestaudio[acodec^=mp4a][ext=m4a]/bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
    --merge-output-format mp4 \
    --output "$OUT_DIR/%(title)s.%(ext)s" \
    --embed-thumbnail \
    --embed-metadata \
    --embed-subs \
    --sub-langs "en.*" \
    --convert-subs srt \
    --no-playlist \
    --print after_move:filepath \
    "$URL")

echo "Downloaded: $DOWNLOADED_FILE"

[ -f "$DOWNLOADED_FILE" ] || { echo "Warning: file not found, skipping optimize"; exit 0; }

OPT_FILE="${DOWNLOADED_FILE%.*}.optimized.mp4"
OPT_LOG="${DOWNLOADED_FILE%.*}.optimize.log"

nohup ffmpeg -i "$DOWNLOADED_FILE" \
    -c:v libx264 -profile:v high -level 4.0 -pix_fmt yuv420p \
    -crf 23 -preset slow -vf scale=-2:720 -r 24 \
    -c:a aac -b:a 96k \
    -movflags +faststart \
    "$OPT_FILE" > "$OPT_LOG" 2>&1 &

echo "Optimizing in bg (PID $!) -> $OPT_FILE (log: $OPT_LOG)"